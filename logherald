# a new host's backlog: what it sends during BACKLOG_PERIOD after it was first seen, time-stamped more than
# BACKLOG_TOLERANCE before that; the period keeps a host whose clock or time zone is off from being silenced
BACKLOG_TOLERANCE = 300
BACKLOG_PERIOD = 3600


def compose_batch(entries, dropped, subject, local_host, notes=()):
    """Subject and text of a batch; identical messages are listed once, with their count."""
    hosts = sorted({entry.host or local_host for entry in entries})
    subject = subject.format(host=", ".join(hosts) if len(hosts) <= 3 else "%d hosts" % len(hosts),
                             count=len(entries) + dropped)
    lines = []
    if dropped:
        lines.append("%d older message(s) were dropped, the buffer was full" % dropped)
    lines += notes
    for entry, count, last in collapse_repeats(entries, local_host):
        line = format_entry(entry, local_host)
        if count > 1:
            line += " (×%d, last %s)" % (count, time.strftime("%H:%M:%S", time.localtime(last)))
        lines.append(line)
    return subject, "\n".join(lines) + "\n"


def write_private(path, text):
    """Replace a file atomically, readable by its owner only; creates its directory."""
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, mode=0o700, exist_ok=True)
    temporary = path + ".tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)


class KnownHosts:
    """The hosts stream mode has seen, with when it first saw each, in a file of "HOST TIME" lines."""

    def __init__(self, path):
        self.path = path
        self.first_seen = {}
        try:
            with open(path, encoding="utf-8") as handle:
                for line in handle:
                    host, _, stamp = line.strip().partition(" ")
                    try:
                        self.first_seen[host] = float(stamp)
                    except ValueError:
                        continue
        except FileNotFoundError:
            pass
        except OSError as err:
            warn("cannot read %s: %s" % (path, err.strerror))

    def see(self, host, now):
        """When host was first seen, and whether that is now; a new host is added to the file."""
        host = short_host(host, "")
        if host in self.first_seen:
            return self.first_seen[host], False
        self.first_seen[host] = now
        try:
            directory = os.path.dirname(self.path)
            if directory:
                os.makedirs(directory, mode=0o700, exist_ok=True)
            with open(self.path, "a", encoding="utf-8") as handle:
                handle.write("%s %.0f\n" % (host, now))
        except OSError as err:
            warn("cannot write %s: %s" % (self.path, err.strerror))
        return now, True


class Batch:
    """Messages waiting to be sent; each destination keeps what it could not send yet.

    A send takes what is pending (take), sends it, possibly in a thread (deliver), and puts back what
    failed (settle). What one destination gets is a parcel: (entries, dropped, stale, notes).
    """

    def __init__(self, config, local_host, output=None):
        self.config = config
        self.local_host = local_host
        self.output = output       # print the batches here instead of sending them
        if output is not None:
            self.destinations = ["print"]
        else:
            self.destinations = [name for name in ("mail", "xmpp") if config[name].get("to")]
        self.pending = {name: [] for name in self.destinations}
        self.dropped = {name: 0 for name in self.destinations}
        self.stale = {name: 0 for name in self.destinations}    # left out, older than max_age
        self.notes = {name: [] for name in self.destinations}   # lines for the next batch
        self.first = None          # when the oldest unsent message arrived
        self.taken_first = None    # the same for what take() took
        self.retry_at = 0.0
        self.failures = 0
        self.max_buffer = int(config["max_buffer"])

    def add(self, entry):
        for name in self.destinations:
            pending = self.pending[name]
            pending.append(entry)
            if len(pending) > self.max_buffer:
                del pending[0]
                self.dropped[name] += 1
        if self.first is None:
            self.first = time.monotonic()

    def add_stale(self):
        for name in self.destinations:
            self.stale[name] += 1

    def note(self, text):
        """A line for the next batch; it does not make one due."""
        for name in self.destinations:
            self.notes[name].append(text)

    def size(self):
        return max((len(pending) for pending in self.pending.values()), default=0)

    def waiting(self):
        return self.size() > 0 or any(self.dropped.values())

    def due(self, now):
        """Whether to send now, and how long the main loop may wait otherwise."""
        if not self.waiting():
            return False, None
        if now < self.retry_at:
            return False, self.retry_at - now
        if self.size() >= int(self.config["max_lines"]):
            return True, 0
        deadline = self.first + float(self.config["interval"])
        return now >= deadline, max(0.0, deadline - now)

    def send(self, name, subject, body):
        if name == "print":
            self.output.write("Subject: %s\n\n%s\n" % (subject, body))
            self.output.flush()
        elif name == "mail":
            send_mail(self.config["mail"], subject, body, False, self.local_host)
        else:
            send_xmpp(self.config["xmpp"], self.config["xmpp"]["to"], subject + "\n\n" + body)

    def take(self):
        """Remove what is pending, as {destination: parcel}, to send it."""
        parcels = {}
        for name in self.destinations:
            if self.pending[name] or self.dropped[name]:
                parcels[name] = (self.pending[name], self.dropped[name], self.stale[name], self.notes[name])
                self.pending[name], self.dropped[name], self.stale[name], self.notes[name] = [], 0, 0, []
        self.taken_first, self.first = self.first, None
        return parcels

    def deliver(self, parcels):
        """Send the parcels and return those that failed; changes nothing, so it may run in a thread."""
        failed = {}
        for name, (entries, dropped, stale, notes) in parcels.items():
            if stale:
                notes = notes + ["%d message(s) older than %gs were not reported"
                                 % (stale, float(self.config["max_age"]))]
            subject, body = compose_batch(entries, dropped, self.config["subject"], self.local_host, notes)
            try:
                self.send(name, subject, body)
            except HeraldError as err:
                warn("%s: %s; %d message(s) kept" % (name, err, len(entries)))
                failed[name] = parcels[name]
        return failed

    def restore(self, name, entries, dropped, stale, notes):
        """Put a parcel back, before what is pending; beyond max_buffer the oldest are dropped."""
        pending = list(entries) + self.pending[name]
        excess = len(pending) - self.max_buffer
        if excess > 0:
            del pending[:excess]
            dropped += excess
        self.pending[name] = pending
        self.dropped[name] += dropped
        self.stale[name] += stale
        self.notes[name] = list(notes) + self.notes[name]

    def settle(self, failed):
        """Put back what failed, and retry after 30 seconds, then 60, 120 and so on up to an hour."""
        for name, parcel in failed.items():
            self.restore(name, *parcel)
        if failed:
            self.failures += 1
            self.retry_at = time.monotonic() + min(30 * 2 ** (self.failures - 1), 3600)
            if self.taken_first is not None:
                self.first = self.taken_first if self.first is None else min(self.first, self.taken_first)
        else:
            self.failures = 0
            self.retry_at = 0.0
        self.taken_first = None
        if not self.waiting():
            self.first = None

    def flush(self):
        """Send what is pending; returns False if a destination failed, which keeps its messages."""
        failed = self.deliver(self.take())
        self.settle(failed)
        return not failed

    def dump(self, sending=None):
        """What is unsent, for the spool: what a send in progress took, then what is pending."""
        data = {}
        for name in self.destinations:
            entries, dropped, stale, notes = (sending or {}).get(name, ([], 0, 0, []))
            entries = list(entries) + self.pending[name]
            dropped += self.dropped[name]
            stale += self.stale[name]
            notes = list(notes) + self.notes[name]
            if entries or dropped or stale or notes:
                data[name] = {"entries": [{slot: getattr(entry, slot) for slot in Entry.__slots__}
                                          for entry in entries],
                              "dropped": dropped, "stale": stale, "notes": notes}
        return data

    def load(self, data):
        """Take up what dump() kept; destinations that are no longer configured are left out."""
        for name in self.destinations:
            item = data.get(name)
            if not isinstance(item, dict):
                continue
            try:
                entries = [Entry(**fields) for fields in item.get("entries") or []]
                self.restore(name, entries, int(item.get("dropped") or 0), int(item.get("stale") or 0),
                             [str(note) for note in item.get("notes") or []])
            except (TypeError, ValueError) as err:
                warn("invalid spooled messages for %s: %s" % (name, err))
        if self.waiting() and self.first is None:
            self.first = time.monotonic()


class Streamer:
    def __init__(self, config, stdin, stdout, print_batches=False, verbose=False):
        self.config = config
        self.levels, self.include, self.exclude = filters(config)
        self.format = str(config.get("format", "auto")).lower()
        if self.format not in ("auto", "json", "syslog", "text"):
            raise HeraldError("format is auto, json, syslog or text, not %r" % config.get("format"))
        self.confirm = bool(config.get("confirm"))
        if print_batches and self.confirm:
            raise HeraldError("--print writes to stdout, where --confirm answers omprog")
        self.batch = Batch(config, socket.getfqdn(), stdout if print_batches else None)
        if not self.batch.destinations:
            raise HeraldError("no recipients: set mail: to and/or xmpp: to, or use --print")
        try:
            self.max_age = float(config.get("max_age") or 0)
        except ValueError:
            raise HeraldError("max_age is a number of seconds, not %r" % config.get("max_age"))
        self.known_hosts = KnownHosts(str(config["known_hosts"])) if config.get("known_hosts") else None
        self.spool = str(config["spool"]) if config.get("spool") else None
        self.stdin = stdin
        self.stdout = stdout
        self.verbose = verbose
        self.stopping = False
        self.flush_requested = False
        self.partial = b""
        self.sender = None         # the thread of a send in progress
        self.sending = None        # the parcels it sends
        self.failed = None         # those it could not send
        if self.spool:
            self.read_spool()

    def acknowledge(self):
        # omprog with confirmMessages="on" waits for OK at the start and after every message
        if self.confirm:
            self.stdout.write("OK\n")
            self.stdout.flush()

    def handle(self, raw):
        received = time.time()
        text = raw.decode("utf-8", "replace")
        if self.format == "text":
            text = text.rstrip("\r\n")
            entry = Entry(received, "", "", "", text, None, "stdin") if text.strip() else None
        else:
            try:
                entry = parse_stream_line(text, received, self.format)
            except ValueError as err:
                warn("cannot parse %r: %s" % (text[:200], err))
                entry = None
        if entry is not None and self.backlog(entry, received):
            entry = None
        if entry is not None and selected(entry, self.levels, self.include, self.exclude):
            if self.max_age and received - entry.time > self.max_age:
                self.batch.add_stale()
                if self.verbose:
                    warn("too old: %s" % format_entry(entry, self.batch.local_host))
            else:
                self.batch.add(entry)
                if self.verbose:
                    warn("queued: %s" % format_entry(entry, self.batch.local_host))
        self.acknowledge()

    def backlog(self, entry, received):
        """Whether the entry belongs to the backlog of a new host, see BACKLOG_PERIOD; needs known_hosts."""
        if self.known_hosts is None or not entry.host:
            return False
        first, new = self.known_hosts.see(entry.host, received)
        if new:
            text = "new host %s: its messages from before %s are not reported" % (
                entry.host, format_time(first - BACKLOG_TOLERANCE))
            warn(text)
            self.batch.note(text)
        return received - first < BACKLOG_PERIOD and entry.time < first - BACKLOG_TOLERANCE

    def read_spool(self):
        try:
            with open(self.spool, encoding="utf-8") as handle:
                data = json.load(handle)
        except FileNotFoundError:
            return
        except (OSError, ValueError) as err:
            warn("cannot read %s: %s" % (self.spool, err))
            return
        if isinstance(data, dict):
            self.batch.load(data)
        if self.verbose and self.batch.waiting():
            warn("%d message(s) from %s" % (self.batch.size(), self.spool))

    def write_spool(self, sending=None):
        """Keep what is unsent in the spool, or remove it if nothing is; returns False if that failed."""
        data = self.batch.dump(sending)
        try:
            if data:
                write_private(self.spool, json.dumps(data, ensure_ascii=False))
            else:
                try:
                    os.unlink(self.spool)
                except FileNotFoundError:
                    pass
            return True
        except OSError as err:
            warn("cannot write %s: %s" % (self.spool, err))
            return False

    def start_send(self, wake_write):
        """Send what is pending in a thread, so that stdin is read meanwhile and rsyslog is not held up."""
        parcels = self.batch.take()
        if not parcels:
            return

        def deliver():
            self.failed = self.batch.deliver(parcels)
            try:
                os.write(wake_write, b"\0")      # wakes the main loop
            except OSError:
                pass

        self.sending = parcels
        self.sender = threading.Thread(target=deliver, name="send", daemon=True)
        self.sender.start()

    def finish_send(self, wait=False):
        """Settle a send that is done, or with wait, wait for it; returns what failed, or None."""
        if self.sender is None or (self.sender.is_alive() and not wait):
            return None
        self.sender.join()
        failed = self.failed
        self.batch.settle(failed)
        self.sender = self.sending = self.failed = None
        if self.spool:
            self.write_spool()
        return failed

    def run(self):
        # a signal handler only sets a flag; the wakeup pipe makes select() return so the loop sees it
        wake_read, wake_write = os.pipe()
        os.set_blocking(wake_read, False)
        os.set_blocking(wake_write, False)
        old_wakeup = signal.set_wakeup_fd(wake_write)
        handlers = {signum: signal.signal(signum, handler) for signum, handler in
                    ((signal.SIGTERM, self.stop), (signal.SIGINT, self.stop), (signal.SIGUSR1, self.request_flush))}
        try:
            return self.loop(wake_read, wake_write)
        finally:
            signal.set_wakeup_fd(old_wakeup)
            for signum, handler in handlers.items():
                signal.signal(signum, handler)
            os.close(wake_read)
            os.close(wake_write)

    def loop(self, wake_read, wake_write):
        self.acknowledge()
        fd = self.stdin.fileno()
        while not self.stopping:
            self.finish_send()
            if self.sender is None:
                due, wait = self.batch.due(time.monotonic())
                if due or self.flush_requested:
                    self.flush_requested = False
                    self.start_send(wake_write)
                    continue
            else:
                wait = None        # the sender wakes us when it is done
            ready, _, _ = select.select([fd, wake_read], [], [], wait)
            if wake_read in ready:
                try:
                    os.read(wake_read, 512)
                except BlockingIOError:
                    pass
            if fd not in ready:
                continue
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            self.partial += chunk
            while b"\n" in self.partial:
                line, self.partial = self.partial.split(b"\n", 1)
                self.handle(line)
                if self.sender is None and self.batch.due(time.monotonic())[0]:
                    self.start_send(wake_write)
        if self.partial.strip():
            self.handle(self.partial)
            self.partial = b""
        # the input ended or we were asked to stop. Spool what is unsent first, in case rsyslog kills us
        # while sending; then wait for a send in progress, or try once more
        if self.spool:
            self.write_spool(self.sending)
        failed = self.finish_send(wait=True)
        if self.batch.waiting() and not failed:
            self.batch.retry_at = 0.0
            self.batch.flush()
        if self.spool and self.write_spool() and self.batch.waiting():
            warn("%d message(s) could not be sent before exiting, kept in %s" % (self.batch.size(), self.spool))
        elif self.batch.waiting():
            warn("%d message(s) could not be sent before exiting" % self.batch.size())
            return 1
        return 0

    def stop(self, signum, frame):
        self.stopping = True

    def request_flush(self, signum, frame):
        self.flush_requested = True


def run_stream(args):
    config = load_config(args)
    streamer = Streamer(config, sys.stdin.buffer, sys.stdout, print_batches=args.print, verbose=args.verbose)
    return streamer.run()


