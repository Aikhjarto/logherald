# sending
# ---------------------------------------------------------------------------

def send_mail(config, subject, body, high, host):
    message = email.message.EmailMessage()
    message["From"] = config.get("from") or "logherald@%s" % host
    message["To"] = ", ".join(config["to"])
    message["Subject"] = subject
    message["Date"] = email.utils.formatdate(localtime=True)
    message["Message-ID"] = email.utils.make_msgid(domain=host)
    message["Auto-Submitted"] = "auto-generated"
    if high:
        message["X-Priority"] = "1 (Highest)"
        message["Importance"] = "high"
        message["Priority"] = "urgent"
    message.set_content(body)
    if config.get("method", "smtp") == "sendmail":
        try:
            result = subprocess.run([config["sendmail"], "-t", "-oi"], input=message.as_bytes(),
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
        except OSError as err:
            raise HeraldError("cannot run %s: %s" % (config["sendmail"], err.strerror))
        except subprocess.TimeoutExpired:
            raise HeraldError("%s did not finish within 120s" % config["sendmail"])
        if result.returncode != 0:
            raise HeraldError("%s failed: %s" % (config["sendmail"], result.stderr.decode("utf-8", "replace").strip()))
        return
    try:
        with smtplib.SMTP(config.get("host", "localhost"), int(config.get("port", 25)), timeout=60) as smtp:
            smtp.send_message(message)
    except (OSError, smtplib.SMTPException) as err:
        raise HeraldError("cannot send mail via %s:%s: %s" % (config.get("host"), config.get("port"), err))


def send_xmpp(config, recipients, text):
    command = [config["go_sendxmpp"]]
    if config.get("config"):
        command += ["-f", config["config"]]
    if config.get("chatroom"):
        command.append("-c")
    command += [str(arg) for arg in config.get("args") or []] + list(recipients)
    timeout = float(config.get("timeout") or 120)
    try:
        result = subprocess.run(command, input=text.encode("utf-8"), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                timeout=timeout)
    except OSError as err:
        raise HeraldError("cannot run %s: %s" % (config["go_sendxmpp"], err.strerror))
    except subprocess.TimeoutExpired:
        raise HeraldError("%s did not finish within %gs" % (config["go_sendxmpp"], timeout))
    if result.returncode != 0:
        raise HeraldError("%s failed: %s" % (config["go_sendxmpp"],
                                             result.stderr.decode("utf-8", "replace").strip() or result.returncode))


# ---------------------------------------------------------------------------
# configuration
# ---------------------------------------------------------------------------

def merge_config(base, override):
    result = dict(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge_config(result[key], value)
        else:
            result[key] = value
    return result


def load_yaml(path):
    try:
        import yaml
    except ImportError:
        raise HeraldError("reading %s needs PyYAML (python3-PyYAML / python3-yaml)" % path)
    try:
        with open(path, encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
    except OSError as err:
        raise HeraldError("cannot read %s: %s" % (path, err.strerror))
    except yaml.YAMLError as err:
        raise HeraldError("invalid YAML in %s: %s" % (path, err))
    if not isinstance(data, dict):
        raise HeraldError("%s must contain a mapping" % path)
    return data


def mode_config(data, mode):
    """The settings of one mode: the common ones, overridden by the mode's section."""
    for key in data:
        if key not in COMMON and key not in ("digest", "stream"):
            raise HeraldError("unknown setting %r; settings of one mode go in its section, digest: or stream:" % key)
    sections = {}
    for name in ("digest", "stream"):
        section = data.get(name) or {}
        if not isinstance(section, dict):
            raise HeraldError("%s: must be a mapping" % name)
        for key in section:
            if key not in COMMON and key not in DEFAULTS[name]:
                raise HeraldError("unknown setting %r in %s:" % (key, name))
        sections[name] = section
    config = {key: DEFAULTS[key] for key in COMMON}
    config = merge_config(config, {key: data[key] for key in COMMON if key in data})
    config = merge_config(config, DEFAULTS[mode])
    return merge_config(config, sections[mode])


def add_common_options(parser):
    parser.add_argument("-C", "--config", help="YAML configuration file")
    parser.add_argument("-p", "--priority",
                        help="severity, like journalctl -p: a level and all more severe ones, or FROM..TO "
                             "(default: warning)")
    parser.add_argument("--include", action="append", metavar="FIELD=REGEX",
                        help="report messages that match, whatever their severity; FIELD is host, program, "
                             "facility, message, unit or origin; repeatable")
    parser.add_argument("--exclude", action="append", metavar="FIELD=REGEX",
                        help="leave out messages that match; repeatable")
    parser.add_argument("--mail-to", action="append", metavar="ADDRESS", help="mail recipient; repeatable")
    parser.add_argument("--xmpp-to", action="append", metavar="JID", help="XMPP recipient; repeatable")
    parser.add_argument("--xmpp-config", help="go-sendxmpp's configuration file")
    parser.add_argument("-v", "--verbose", action="store_true", help="explain on stderr what is done")


def build_parser():
    parser = argparse.ArgumentParser(
        prog="logherald",
        description="Select log messages by severity and rules, and send them by mail and XMPP: as a digest of "
                    "a time span from the journal and rsyslog's files, or in batches from a stream such as "
                    "rsyslog's omprog.")
    parser.add_argument("-V", "--version", action="version", version="logherald %s" % VERSION)
    modes = parser.add_subparsers(dest="mode", metavar="MODE")
    modes.required = True

    digest = modes.add_parser(
        "digest", help="a digest of a time span from the journal and the files rsyslog writes",
        description="Send a digest of the messages of a time span from the systemd journal and the files rsyslog "
                    "writes. Messages that appear in both are counted once.",
        epilog="--since and --until take the syntax of journalctl, e.g. -1h, \"1 hour ago\", today, "
               "\"2026-10-02 08:00\". Options given here override the configuration file.")
    add_common_options(digest)
    digest.add_argument("-S", "--since", help="start of the time span (default: -1h)")
    digest.add_argument("-U", "--until", help="end of the time span (default: now)")
    digest.add_argument("-n", "--max-lines", type=int,
                        help="list the messages only up to this many, above it send with high priority (default: 100)")
    digest.add_argument("--top", type=int, help="rows of the host and program table (default: 10)")
    digest.add_argument("--no-journal", action="store_true", help="do not read the journal")
    digest.add_argument("--no-rsyslog", action="store_true", help="do not read rsyslog's files")
    digest.add_argument("--rsyslog-config", help="rsyslog's configuration (default: /etc/rsyslog.conf)")
    digest.add_argument("--journal-arg", action="append", metavar="ARG",
                        help="argument for journalctl instead of --merge, e.g. --directory=/var/log/journal/remote; "
                             "repeatable")
    digest.add_argument("--print", action="store_true", help="print the digest instead of sending it")
    digest.add_argument("--show-sources", action="store_true",
                        help="print the files rsyslog writes with the severities they hold, and exit")

    stream = modes.add_parser(
        "stream", help="batches of the messages arriving on stdin, e.g. from rsyslog's omprog",
        description="Read messages from stdin, one per line, as rsyslog's omprog writes them, and send those "
                    "that pass the filters in batches.",
        epilog="A batch is sent after --max-lines messages, --interval seconds after its first message, at the "
               "end of the input, and on SIGTERM, SIGINT or SIGUSR1. Options given here override the "
               "configuration file.")
    add_common_options(stream)
    stream.add_argument("-n", "--max-lines", type=int, help="send after this many messages (default: 20)")
    stream.add_argument("-s", "--interval", type=float,
                        help="send this many seconds after the first message of a batch (default: 300)")
    stream.add_argument("--format", choices=("auto", "json", "syslog", "text"),
                        help="input: rsyslog's %%jsonmesg%%, syslog lines (RFC 5424, or a time stamp and host, "
                             "optionally after <PRI>), or plain text (default: auto)")
    stream.add_argument("--max-age", type=float, metavar="SECONDS",
                        help="do not report messages time-stamped longer ago (default: 0, no limit)")
    stream.add_argument("--known-hosts", metavar="FILE",
                        help="file of the hosts seen; a new host's backlog is not reported (default: none)")
    stream.add_argument("--spool", metavar="FILE",
                        help="keep unsent messages in this file across restarts (default: none)")
    stream.add_argument("--confirm", action="store_true",
                        help="answer OK to every message, for omprog's confirmMessages=\"on\"")
    stream.add_argument("--print", action="store_true", help="print the batches instead of sending them")
    return parser


def load_config(args):
    config = mode_config(load_yaml(args.config) if args.config else {}, args.mode)
    cli = {"priority": args.priority, "max_lines": args.max_lines}
    if args.mode == "digest":
        cli.update(since=args.since, until=args.until, top=args.top)
    else:
        cli.update(interval=args.interval, format=args.format, max_age=args.max_age, known_hosts=args.known_hosts,
                   spool=args.spool)
        if args.confirm:
            config["confirm"] = True
    config.update({key: value for key, value in cli.items() if value is not None})
    if args.include:
        config["include"] = list(config.get("include") or []) + args.include
    if args.exclude:
        config["exclude"] = list(config.get("exclude") or []) + args.exclude
    if args.mail_to:
        config["mail"] = dict(config["mail"], to=args.mail_to)
    if args.xmpp_to:
        config["xmpp"] = dict(config["xmpp"], to=args.xmpp_to)
    if args.xmpp_config:
        config["xmpp"] = dict(config["xmpp"], config=args.xmpp_config)
    if args.mode == "digest":
        if args.no_journal:
            config["journal"] = dict(config["journal"], enabled=False)
        if args.no_rsyslog:
            config["rsyslog"] = dict(config["rsyslog"], enabled=False)
        if args.rsyslog_config:
            config["rsyslog"] = dict(config["rsyslog"], config=args.rsyslog_config)
        if args.journal_arg:
            config["journal"] = dict(config["journal"], args=args.journal_arg)
    for section in ("mail", "xmpp"):
        for key in ("to", "high_priority_to"):
            value = config[section].get(key)
            if isinstance(value, str):
                config[section] = dict(config[section], **{key: [value]})
    return config


def filters(config):
    try:
        return (parse_priority(config["priority"]), [parse_rule(rule) for rule in config.get("include") or []],
                [parse_rule(rule) for rule in config.get("exclude") or []])
    except ValueError as err:
        raise HeraldError(str(err))


def enabled(value):
    """True, False or "auto" from the configuration."""
    if isinstance(value, str):
        value = value.strip().lower()
        if value == "auto":
            return "auto"
        return value in ("1", "yes", "true", "on")
    return bool(value)


# ---------------------------------------------------------------------------
# digest mode
# ---------------------------------------------------------------------------

def collect(config, since, until, levels, include, verbose, problems, sources):
    entries = []
    margin = float(config["duplicate_window"])

    journal = config["journal"]
    use_journal = enabled(journal.get("enabled", "auto"))
    if use_journal == "auto":
        use_journal = shutil.which(journal["journalctl"]) is not None
    if use_journal:
        try:
            found = read_journal(journal, since, until, levels, bool(include))
            entries += found
            sources.append("journal")
            if verbose:
                sys.stderr.write("journal: %d entries\n" % len(found))
        except HeraldError as err:
            problems.append(str(err))

    rsyslog = config["rsyslog"]
    use_rsyslog = enabled(rsyslog.get("enabled", "auto"))
    if use_rsyslog == "auto":
        use_rsyslog = os.path.exists(rsyslog["config"])
    if not use_rsyslog:
        return entries
    targets = collections.OrderedDict()
    try:
        parsed = RsyslogConfig(rsyslog["config"])
        targets.update(parsed.targets)
        problems += parsed.problems
    except HeraldError as err:
        problems.append(str(err))
    for extra in rsyslog.get("files") or []:
        try:
            targets.setdefault(extra["path"], set()).update(parse_priority(extra.get("priority", "debug")))
        except (KeyError, TypeError, ValueError) as err:
            problems.append("invalid rsyslog.files entry %r: %s" % (extra, err))
    read_any = False
    for pattern, file_levels in targets.items():
        if not file_levels:
            continue
        if not file_levels & levels and not include:
            if verbose:
                sys.stderr.write("rsyslog: skipping %s, it holds none of the severities\n" % pattern)
            continue
        for path in log_files(pattern, since - margin):
            try:
                found = read_log_file(path, frozenset(file_levels), levels, since, until, margin)
            except (OSError, EOFError, lzma.LZMAError) as err:
                problems.append("cannot read %s: %s" % (path, getattr(err, "strerror", None) or err))
                continue
            read_any = True
            entries += found
            if verbose:
                sys.stderr.write("rsyslog: %s (%s): %d lines\n" % (
                    path, ",".join(LEVELS[level] for level in sorted(file_levels)), len(found)))
    if read_any or targets:
        sources.append("rsyslog")
    return entries


def run_digest(args):
    config = load_config(args)
    host = socket.getfqdn()
    local_short = host.split(".")[0]

    if args.show_sources:
        parsed = RsyslogConfig(config["rsyslog"]["config"])
        for pattern, levels in parsed.targets.items():
            print("%-40s %s" % (pattern, ",".join(LEVELS[level] for level in sorted(levels))))
        for problem in parsed.problems:
            print("problem: %s" % problem)
        return 0

    levels, include, exclude = filters(config)
    try:
        now = time.time()
        since = parse_time(config["since"], now)
        until = parse_time(config["until"], now)
    except ValueError as err:
        raise HeraldError(str(err))
    if since > until:
        raise HeraldError("--since is after --until")

    problems = []
    sources = []
    entries = collect(config, since, until, levels, include, args.verbose, problems, sources)
    entries = [entry for entry in entries if since <= entry.time <= until and selected(entry, levels, include, exclude)]
    entries, merged = merge_duplicates(entries, float(config["duplicate_window"]), local_short)

    digest = {"host": host, "since": since, "until": until, "levels": levels, "include": include,
              "exclude": exclude, "sources": sources, "merged": merged, "problems": problems,
              "max_lines": int(config["max_lines"]), "top": int(config["top"]), "subject": config["subject"]}
    subject, body, summary, high = build_digest(entries, digest)

    mail, xmpp = config["mail"], config["xmpp"]
    if args.print or not (mail.get("to") or xmpp.get("to")):
        sys.stdout.write("Subject: %s\n\n%s" % (subject, body))
        return 0
    if not entries and not problems and not config.get("send_empty"):
        if args.verbose:
            sys.stderr.write("nothing to send\n")
        return 0
    failures = []
    if mail.get("to"):
        try:
            send_mail(mail, subject, body, high, host)
        except HeraldError as err:
            failures.append(str(err))
    if xmpp.get("to"):
        recipients = list(xmpp["to"]) + (list(xmpp.get("high_priority_to") or []) if high else [])
        text = subject + "\n\n" + (body if xmpp.get("full") else summary)
        try:
            send_xmpp(xmpp, recipients, text)
        except HeraldError as err:
            failures.append(str(err))
    for failure in failures:
        warn(failure)
    return 1 if failures else 0


